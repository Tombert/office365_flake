+/**********************************************************************
+ *          wayland_surface_get_maximized_frame
+ *
+ * Gets the frame by which Windows extends a maximized window past the work
+ * area on each side (the defaults of win32u's get_min_max_info). Windows keeps
+ * that frame off-screen, and applications that draw their own frame (Office)
+ * clip it away with a window region, so inside the maximized geometry it
+ * would be a transparent strip that passes clicks to the window behind.
+ * Windows whose frame the compositor hides (server-side decorations) have
+ * none.
+ */
+BOOL wayland_surface_get_maximized_frame(struct wayland_surface *surface, SIZE *frame)
+{
+    /* The cached styles: this also runs under the window data lock. */
+    DWORD style = surface->window.style;
+    RECT rect = {0};
+
+    frame->cx = frame->cy = 0;
+
+    if (!wayland_surface_is_toplevel(surface) || surface->window.minimized) return FALSE;
+    if (!EqualRect(&surface->window.rect, &surface->window.window_rect)) return FALSE;
+    if ((style & WS_CHILD) || !(style & WS_THICKFRAME)) return FALSE;
+
+    if ((style & WS_CAPTION) == WS_CAPTION) style &= ~WS_BORDER;
+    if (!NtUserAdjustWindowRect(&rect, style, FALSE, surface->window.exstyle,
+                                NtUserGetSystemDpiForProcess(NULL)))
+        return FALSE;
+    if (rect.left >= 0 || rect.top >= 0) return FALSE;
+
+    frame->cx = -rect.left;
+    frame->cy = -rect.top;
+    return TRUE;
+}
