+static void send_virtual_mod(HWND hwnd, unsigned int i, BOOL down)
+{
+    struct wayland_keyboard *keyboard = &process_wayland.keyboard;
+    UINT scan = key2scan(virtual_mods[i].left);
+    INPUT input = {0};
+
+    TRACE_(key)("%s %s for the compositor's modifier state\n", down ? "pressing" : "releasing",
+                virtual_mods[i].name);
+
+    input.type = INPUT_KEYBOARD;
+    input.ki.wScan = scan;
+    input.ki.dwFlags = KEYEVENTF_SCANCODE;
+    if (!down) input.ki.dwFlags |= KEYEVENTF_KEYUP;
+    NtUserSendHardwareInput(hwnd, 0, &input, 0);
+    /* recorded as held, so release_all_keys() releases it on focus loss */
+    keyboard->keystate[scan] = down;
+    virtual_mod_down[i] = down;
+}
+
+/* key_press: a key that is not a modifier is about to be pressed. Otherwise only releases. */
+static void sync_virtual_mods(HWND hwnd, BOOL key_press)
+{
+    struct wayland_keyboard *keyboard = &process_wayland.keyboard;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(virtual_mods); i++)
+    {
+        BOOL active = FALSE, held;
+
+        if (!key_press && !virtual_mod_down[i]) continue;
+
+        pthread_mutex_lock(&keyboard->mutex);
+        if (keyboard->xkb_state)
+            active = xkb_state_mod_name_is_active(keyboard->xkb_state, virtual_mods[i].name,
+                                                  XKB_STATE_MODS_DEPRESSED | XKB_STATE_MODS_LATCHED) > 0;
+        pthread_mutex_unlock(&keyboard->mutex);
+
+        held = keyboard->keystate[key2scan(virtual_mods[i].right)] ||
+               (keyboard->keystate[key2scan(virtual_mods[i].left)] && !virtual_mod_down[i]);
+
+        if (key_press && active && !held && !virtual_mod_down[i]) send_virtual_mod(hwnd, i, TRUE);
+        else if (virtual_mod_down[i] && !active) send_virtual_mod(hwnd, i, FALSE);
+    }
+}
+
+/* A real event for a modifier key takes over from a virtual press of that modifier. */
+static BOOL is_virtual_mod_key(HWND hwnd, uint32_t key)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(virtual_mods); i++)
+    {
+        if (key != virtual_mods[i].left && key != virtual_mods[i].right) continue;
+        if (virtual_mod_down[i]) send_virtual_mod(hwnd, i, FALSE);
+        return TRUE;
+    }
+    return FALSE;
+}
