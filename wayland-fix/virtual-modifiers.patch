+/* Keyboards that exist only in software, such as Steam's on-screen keyboard, type characters like
+ * '(' by putting Shift into the compositor's modifier state without sending a Shift key event.
+ * Wayland clients that translate keys with xkbcommon see ')', but Windows applications go by the
+ * key state, which only key events change, and get '0'. The modifiers below are pressed with their
+ * left key before such a key press and released when the compositor clears them. */
+static const struct
+{
+    const char *name;
+    uint32_t left, right;
+} virtual_mods[] =
+{
+    {XKB_MOD_NAME_SHIFT, KEY_LEFTSHIFT, KEY_RIGHTSHIFT},
+    {XKB_MOD_NAME_CTRL,  KEY_LEFTCTRL,  KEY_RIGHTCTRL},
+    {XKB_MOD_NAME_ALT,   KEY_LEFTALT,   KEY_RIGHTALT},
+};
+static BOOL virtual_mod_down[ARRAY_SIZE(virtual_mods)];
+
