+/* Whether a window that keeps its frame beyond a maximized config (see
+ * wayland_surface_get_maximized_frame) still needs wayland_configure_window to
+ * size it to that config. A larger window, such as one maximized to the whole
+ * monitor before the first configure, would otherwise lose its bottom and right
+ * edges outside the window geometry. */
+static BOOL wayland_surface_needs_maximized_resize(struct wayland_surface *surface,
+                                                   const struct wayland_surface_config *conf,
+                                                   RECT rect)
+{
+    SIZE frame;
+
+    if ((conf->state & (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED |
+                        WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN)) !=
+        WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED)
+        return FALSE;
+    if (!wayland_surface_get_maximized_frame(surface, &frame)) return FALSE;
+
+    return rect.right - rect.left != conf->rect.right - conf->rect.left + 2 * frame.cx ||
+           rect.bottom - rect.top != conf->rect.bottom - conf->rect.top + 2 * frame.cy;
+}
